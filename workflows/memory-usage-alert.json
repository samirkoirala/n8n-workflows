{
  "name": "Memory Usage Alert",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "id": "schedule",
      "name": "Every 10 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "command": "awk '/MemTotal:/ {t=$2} /MemAvailable:/ {a=$2} END {u=t-a; p=(u*100)/t; cmd=\"hostname\"; cmd | getline h; close(cmd); printf \"%s|%.1f GiB|%.1f GiB|%.1f GiB|%.1f\\n\", h, t/1048576, u/1048576, a/1048576, p}' /proc/meminfo"
      },
      "id": "ssh",
      "name": "SSH Memory Check",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "threshold",
              "leftValue": "={{ Number(($json.stdout || '').trim().split('|')[4]) }}",
              "rightValue": 90,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if",
      "name": "Memory Usage >= 90%?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "YOUR_SLACK_CHANNEL",
          "mode": "id"
        },
        "text": "=🚨 MEMORY USAGE ALERT\n\nServer: {{ $json.stdout.trim().split('|')[0] }}\nTotal: {{ $json.stdout.trim().split('|')[1] }}\nUsed: {{ $json.stdout.trim().split('|')[2] }}\nAvailable: {{ $json.stdout.trim().split('|')[3] }}\nUsage: {{ $json.stdout.trim().split('|')[4] }}%\nThreshold: 90%",
        "otherOptions": {}
      },
      "id": "slack",
      "name": "Send Memory Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        740,
        -80
      ]
    }
  ],
  "connections": {
    "Every 10 Minutes": {
      "main": [
        [
          {
            "node": "SSH Memory Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SSH Memory Check": {
      "main": [
        [
          {
            "node": "Memory Usage >= 90%?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Memory Usage >= 90%?": {
      "main": [
        [
          {
            "node": "Send Memory Alert",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "pinData": {},
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}
