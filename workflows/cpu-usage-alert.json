{
  "name": "CPU Usage Alert",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "id": "schedule",
      "name": "Every 10 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "command": "set -eu; read cpu u n s i w irq sirq steal rest < /proc/stat; total1=$((u+n+s+i+w+irq+sirq+steal)); idle1=$((i+w)); sleep 2; read cpu u n s i w irq sirq steal rest < /proc/stat; total2=$((u+n+s+i+w+irq+sirq+steal)); idle2=$((i+w)); dt=$((total2-total1)); di=$((idle2-idle1)); usage=$(awk -v dt=\"$dt\" -v di=\"$di\" 'BEGIN {if (dt>0) printf \"%.1f\", 100*(dt-di)/dt; else print \"0.0\"}'); printf '%s|%s\\n' \"$(hostname 2>/dev/null || printf unknown)\" \"$usage\""
      },
      "id": "ssh",
      "name": "SSH CPU Sample",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "threshold",
              "leftValue": "={{ Number(($json.stdout || '').trim().split('|')[1]) }}",
              "rightValue": 90,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if",
      "name": "CPU Usage >= 90%?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "YOUR_SLACK_CHANNEL",
          "mode": "id"
        },
        "text": "=🚨 CPU USAGE ALERT\n\nServer: {{ $json.stdout.trim().split('|')[0] }}\nCPU usage: {{ $json.stdout.trim().split('|')[1] }}%\nThreshold: 90%",
        "otherOptions": {}
      },
      "id": "slack",
      "name": "Send CPU Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        740,
        -80
      ]
    }
  ],
  "connections": {
    "Every 10 Minutes": {
      "main": [
        [
          {
            "node": "SSH CPU Sample",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SSH CPU Sample": {
      "main": [
        [
          {
            "node": "CPU Usage >= 90%?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "CPU Usage >= 90%?": {
      "main": [
        [
          {
            "node": "Send CPU Alert",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "pinData": {},
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}
