{
  "name": "GitHub PR Slack Alert",
  "nodes": [
    {
      "parameters": {
        "owner": "YOUR_GITHUB_OWNER",
        "repository": "YOUR_GITHUB_REPOSITORY",
        "events": [
          "pull_request"
        ],
        "options": {}
      },
      "id": "github-trigger",
      "name": "GitHub Pull Request Trigger",
      "type": "n8n-nodes-base.githubTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "opened",
              "leftValue": "={{ $json.body.action }}",
              "rightValue": "opened",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "reopened",
              "leftValue": "={{ $json.body.action }}",
              "rightValue": "reopened",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "action-filter",
      "name": "PR Opened or Reopened?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "YOUR_SLACK_CHANNEL",
          "mode": "id"
        },
        "text": "=🚀 New Pull Request Opened\n\nRepository: {{ $json.body.repository.full_name }}\nPR number: #{{ $json.body.pull_request.number }}\nPR title: {{ $json.body.pull_request.title }}\nCreated by: {{ $json.body.pull_request.user.login }}\nSource branch: {{ $json.body.pull_request.head.ref }}\nTarget branch: {{ $json.body.pull_request.base.ref }}\nDescription: {{ $json.body.pull_request.body || 'No description provided' }}\n<{{ $json.body.pull_request.html_url }}|View pull request>",
        "otherOptions": {}
      },
      "id": "slack-alert",
      "name": "Send Slack Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        500,
        -80
      ]
    },
    {
      "parameters": {},
      "id": "ignore-action",
      "name": "Ignore Other Actions",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        500,
        100
      ]
    }
  ],
  "connections": {
    "GitHub Pull Request Trigger": {
      "main": [
        [
          {
            "node": "PR Opened or Reopened?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "PR Opened or Reopened?": {
      "main": [
        [
          {
            "node": "Send Slack Alert",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Ignore Other Actions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}
